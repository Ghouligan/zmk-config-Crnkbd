#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp C_VOLUME_UP  &kp Q  &kp W  &kp E         &kp R  &kp T        &kp Y    &kp U   &kp I          &kp O    &kp P      &kp TAB
&kp C_VOL_DN     &kp A  &kp S  &mt LSHIFT D  &kp F  &kp G        &kp H    &kp J   &mt RSHFT K    &kp L    &kp SQT    &kp CLCK
&kp LCTRL        &kp Z  &kp X  &kp C         &kp V  &kp B        &kp N    &kp M   &kp COMMA      &kp DOT  &kp SLASH  &kp RIGHT_ALT
                               &kp LGUI      &mo 1  &kp SPACE    &kp RET  &tog 2  &kp BACKSPACE
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp N5        &kp NUMBER_6  &kp N7        &kp N8        &kp N9       &kp EQUAL  &kp NON_US_BACKSLASH  &kp ESC             &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &tog 0
&kp LSHFT  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N0       &kp LEFT   &kp DOWN              &mt RSHFT UP_ARROW  &kp RIGHT         &kp MINUS          &tog 2
&trans     &trans        &trans        &trans        &trans        &kp GRAVE    &trans     &kp PAGE_DOWN         &kp PAGE_UP         &kp SEMICOLON     &trans             &trans
                                       &kp LGUI      &trans        &kp SPACE    &kp RET    &trans                &kp BACKSPACE
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp M      &kp Q   &trans  &kp W     &kp E   &kp ESCAPE    &bt BT_CLR    &bt BT_CLR_ALL  &bt BT_NXT     &bt BT_PRV    &out OUT_TOG  &tog 0
&kp LCTRL  &trans  &kp A   &kp S     &kp D   &trans        &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4  &tog 1
&kp LSHFT  &trans  &trans  &trans    &trans  &trans        &trans        &trans          &trans         &trans        &trans        &trans
                           &kp LGUI  &trans  &kp SPACE     &kp RET       &trans          &kp BACKSPACE
            >;
        };
    };
};
